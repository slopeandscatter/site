    fill: var(--color-plot);
  }
  .scatter-index :global(.ax-line) {
    stroke: var(--color-base-950);
    stroke-width: 1.25;
    fill: none;
  }
  .scatter-index :global(.tick) {
    stroke: var(--color-rule);
    stroke-width: 1;
  }
  .scatter-index :global(.tick-label) {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--color-base-400);
    letter-spacing: 0.06em;
  }
  .scatter-index :global(.ax-label) {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--color-base-950);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .scatter-index :global(.fit-band) {
    opacity: 0.085;
  }
  .scatter-index :global(.fit-line) {
    fill: none;
    stroke-width: 1.5;
    opacity: 0.6;
  }
  .scatter-index :global(.fit-label) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    font-weight: 500;
    opacity: 0.85;
  }
  .scatter-index :global(.callout line) {
    stroke: var(--color-base-950);
    stroke-width: 1;
  }
  .scatter-index :global(.callout text) {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--color-base-950);
  }
  .scatter-index :global(.pt) {
    cursor: pointer;
  }
  .scatter-index :global(.pt .halo) {
    fill: none;
    stroke-width: 1.25;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .scatter-index :global(.pt:hover .halo),
  .scatter-index :global(.pt:focus-visible .halo) {
    opacity: 1;
  }
  .scatter-index :global(.pt:focus) {
    outline: none;
  }
  .scatter-index :global(.pt:focus-visible .core) {
    stroke: var(--color-base-950);
    stroke-width: 2;
  }
  [data-card].is-on {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .scatter-index *,
    .scatter-index :global(*) {
      animation-duration: 0.001ms !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
