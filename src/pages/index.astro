---
/**
 * Homepage — the index is a scatter plot.
 *
 * Points are positioned by publication date against reading time, both derived, so
 * publishing a piece costs no extra bookkeeping. Filling in the optional analysis
 * fields on a few pieces makes further axis pairs appear on their own; see
 * `src/content.config.ts` and `src/components/scatter/ScatterIndex.astro`.
 */
import ScatterIndex, { type ScatterPoint } from "@components/scatter/ScatterIndex.astro";
import { desks, getDesk } from "@config/desks";
import { defaultLocale } from "@config/siteSettings.json";
import { countSources, getAllPosts, readingTime } from "@js/blogUtils";
import BaseLayout from "@layouts/BaseLayout.astro";
import { Image } from "astro:assets";

// same helper the /blog/[...slug] route uses, so post.id here is the same slug it
// generates — locale prefix already stripped
const posts = await getAllPosts(defaultLocale);

const points: ScatterPoint[] = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  desk: post.data.desk,
  date: post.data.pubDate.getTime(),
  mins: readingTime(post.body),
  sources: countSources(post.body),
  money: post.data.money,
  cert: post.data.cert,
  work: post.data.work,
  surp: post.data.surp,
  scope: post.data.scope,
}));

// The featured piece: an explicit `featured: true` wins, newest breaks ties, and with
// nothing flagged the newest piece is featured anyway — so the box is never empty.
const byNewest = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = byNewest.find((p) => p.data.featured) ?? byNewest[0];
const featuredDesk = featured ? getDesk(featured.data.desk) : undefined;
const featuredMins = featured ? readingTime(featured.body) : 0;

// The desk index that fills the header: the taxonomy, introduced before the chart that
// uses it, with real counts rather than decoration.
const deskCounts = desks.map((desk) => ({
  ...desk,
  count: posts.filter((p) => p.data.desk === desk.id).length,
}));
---

<BaseLayout
  title="Slope & Scatter"
  description="Questions nobody bothered to measure. Infrastructure, rent, games, sport, film — every piece ships the model behind the answer, and every assumption it rests on."
>
  <div class="mx-auto w-full max-w-6xl px-6">
    <div class="relative">
      <div class="relative z-10 pt-10 pb-8 md:pt-14 md:pb-0">
        <section>
          <p
            class="text-base-600 flex items-center gap-2.5 font-mono text-[11.5px] tracking-[0.16em] uppercase"
          >
            <span class="bg-riso-scarlet block size-2 rounded-full"></span>
            Curiosity, measured
          </p>

          <h1
            class="font-display text-base-950 mt-5 text-[2.6rem] leading-[1.04] font-semibold tracking-[-0.035em] text-pretty md:text-[4.2rem]"
          >
            Questions nobody <em class="text-riso-sky not-italic">bothered to measure</em>.
          </h1>

          <p class="text-base-600 mt-5 max-w-[78ch] text-lg text-pretty">
            Infrastructure, rent, games, sport, film — anything with a number hiding in it. Every
            piece ships the model behind the answer, and every assumption it rests on.
          </p>
        </section>
      </div>

      <ScatterIndex points={points} featuredSlug={featured?.id} />
    </div>

    {
      /* The featured piece gets its own room rather than a card floating over the chart:
        the plot is the page's argument, and anything sitting on top of it competes. The
        "Newest" tag and the pulsing ring in the plot point at this piece. */
    }
    {
      featured && (
        <section class="border-base-950 mt-16 border-t pt-8">
          <a
            href={`/blog/${featured.id}/`}
            class="group focus-visible:outline-riso-sky block no-underline focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            <div class="grid gap-6 md:grid-cols-[minmax(0,7rem)_minmax(0,1fr)] md:gap-12">
              <p class="text-base-600 flex items-center gap-2.5 font-mono text-[11px] tracking-[0.16em] uppercase md:pt-[0.55rem]">
                <span
                  class="block size-2 shrink-0 rounded-full"
                  style={`background:${featuredDesk?.hex ?? "#5A6360"}`}
                />
                Start here
              </p>

              <div class="max-w-[46ch]">
                <h2 class="font-display text-base-950 group-hover:text-riso-sky m-0 text-3xl leading-[1.08] font-semibold tracking-[-0.028em] text-balance transition-colors md:text-[2.6rem]">
                  {featured.data.title}
                </h2>
                <p class="text-base-600 mt-4 text-[17px] leading-relaxed">
                  {featured.data.description}
                </p>
                <p class="text-base-950 mt-6 flex items-center gap-5 font-mono text-[11px] tracking-[0.14em] uppercase">
                  <span>Read the piece &rarr;</span>
                  <span class="text-base-400">
                    {featuredDesk?.label ?? featured.data.desk} &middot; {featuredMins} min
                  </span>
                </p>
              </div>
            </div>
          </a>
        </section>
      )
    }

    <section class="border-base-950 mt-20 border-t pt-8">
      <h2 class="text-base-600 m-0 font-mono text-xs font-medium tracking-[0.14em] uppercase">
        How a piece is built
      </h2>
      <div class="mt-6 grid gap-x-0 gap-y-6 md:grid-cols-4">
        {
          [
            {
              n: "Step one",
              h: "The question",
              p: "Something you'd argue about at a bar, phrased tightly enough to have a number as an answer.",
            },
            {
              n: "Step two",
              h: "The model",
              p: "Real unit costs, real rates, stated assumptions. Where the data runs out, we say so and estimate.",
            },
            {
              n: "Step three",
              h: "Your turn",
              p: "The model ships as a thing you can drive. Change the route, the wage, the scope. The answer follows.",
            },
            {
              n: "Step four",
              h: "The receipts",
              p: "Every source, every fudge factor, every place we could be wrong — at the bottom, in full.",
            },
          ].map((step) => (
            <div class="border-rule pr-6 md:border-r md:last:border-r-0">
              <span class="text-base-400 block font-mono text-[11px] tracking-[0.14em]">
                {step.n}
              </span>
              <h3 class="font-display text-base-950 mt-2.5 mb-2 text-xl font-semibold tracking-[-0.02em]">
                {step.h}
              </h3>
              <p class="text-base-600 m-0 text-[15px] leading-relaxed">{step.p}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!--
      The nav's Subscribe button points here, so this section must exist.
      TODO: wire `action` to a real provider. Until then the form is inert and
      deliberately does not pretend otherwise.
    -->
    <section id="newsletter" class="border-rule mt-16 mb-24 border-t pt-8">
      <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
        <div class="max-w-[44ch]">
          <p
            class="text-base-600 flex items-center gap-2.5 font-mono text-[11px] tracking-[0.16em] uppercase"
          >
            <span class="bg-riso-scarlet block size-2 rounded-full"></span>
            One question at a time
          </p>
          <h2
            class="font-display text-base-950 mt-4 text-2xl leading-tight font-semibold tracking-[-0.025em] text-balance md:text-3xl"
          >
            New piece, the model behind it, and what we got wrong last time.
          </h2>
          <p class="text-base-600 mt-3 text-[15px]">
            No more than one email per piece. Corrections included, not buried.
          </p>
        </div>

        <form class="flex w-full max-w-md flex-wrap items-stretch gap-0 md:w-auto">
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="border-base-950 bg-plot text-base-950 placeholder:text-base-400 focus-visible:outline-riso-sky min-w-0 flex-1 border px-3.5 py-2.5 font-mono text-[13px] focus-visible:outline-2 focus-visible:outline-offset-2 md:w-64 md:flex-none"
          />
          <button
            type="submit"
            class="bg-base-950 text-paper hover:bg-riso-sky focus-visible:outline-riso-sky border-base-950 cursor-pointer border border-l-0 px-5 py-2.5 font-mono text-[11px] tracking-[0.12em] uppercase transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            Subscribe
          </button>
        </form>
      </div>
    </section>
  </div>
</BaseLayout>
